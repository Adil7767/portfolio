NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pooler (6543) — ok for drizzle-kit; Next.js app prefers DIRECT_URL below
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session mode pooler (5432) — use this on Vercel (copy from Supabase → Connect → Session pooler)
# Do NOT use db.[ref].supabase.co on Vercel — it often returns ENOTFOUND
DIRECT_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-admin-password
SESSION_SECRET=random-long-secret-for-jwt-signing

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=adil-portfolio
NEXT_PUBLIC_CLOUDINARY_CLOUD=
NEXT_PUBLIC_CLOUDINARY_PRESET=
