NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pooler (6543) — ok for drizzle-kit; Next.js app prefers DIRECT_URL below
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (5432) — required for reliable admin API / site content loading
# Use host db.[ref].supabase.co and user "postgres" (not postgres.[ref] — that is for the pooler)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres

ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-admin-password
SESSION_SECRET=random-long-secret-for-jwt-signing

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=adil-portfolio
NEXT_PUBLIC_CLOUDINARY_CLOUD=
NEXT_PUBLIC_CLOUDINARY_PRESET=
